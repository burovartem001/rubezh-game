{
  "name": "rubezh-game",
  "version": "0.1.0",
  "private": true,
  "description": "Рубеж — браузерная стратегия: тыловой полигон взвода БПЛА, отряд, командир и походы на карту секторов",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node build/server/src/index.js",
    "migrate": "node build/server/src/index.js --migrate-only",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "tsx --test tests/calc.test.ts",
    "test:api": "tsx --test tests/api.test.ts",
    "test:awards": "tsx --test tests/awards.test.ts",
    "test:chevrons": "tsx --test tests/chevrons.test.ts",
    "test:long": "tsx --test tests/long.test.ts",
    "test:depth": "tsx --test tests/depth.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
