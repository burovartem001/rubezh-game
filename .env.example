# Строка подключения к PostgreSQL (на Railway подставляется из сервиса Postgres: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://rubezh:rubezh@localhost:5432/rubezh
# Порт HTTP (Railway задаёт сам)
PORT=3000
# Префикс пути, если игру отдаёт основной сайт через обратный прокси (например /game). Пусто — корень.
BASE_PATH=
# Кто может встраивать игру во фрейм: 'self' https://основной-сайт.ru
FRAME_ANCESTORS='self'
# 1 — включить SSL к базе (для внешних подключений, где он обязателен)
PGSSL=
# Ключ для выдачи наград сайтом «Учёт дронов» (пусто — выдача выключена)
INTEGRATION_KEY=
